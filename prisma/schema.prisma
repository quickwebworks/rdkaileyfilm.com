generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  createdAt DateTime @default(now())
}
